# ─────────────────────────────────────────────────────────
# GRIND LAB — Variables de entorno
# Copiá este archivo a `.env` y completá los valores.
# ─────────────────────────────────────────────────────────

# ── PÚBLICAS (van al bundle del navegador — solo claves públicas) ──
# Prefijo VITE_ = expuestas al cliente por Vite.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# VITE_MP_PUBLIC_KEY=tu-mp-public-key   # (diferido)

# ── SERVER-ONLY ──────────────────────────────────────────
# NUNCA con prefijo VITE_. NUNCA en el navegador.
# Van en supabase/functions/.env (local) y en `supabase secrets set` (prod).
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=...
# MP_ACCESS_TOKEN=...        # (diferido)
# MP_WEBHOOK_SECRET=...      # (diferido)

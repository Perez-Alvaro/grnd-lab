        <mxCell id="title" value="Diagrama de Clases del Dominio - Sistema Fitter" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;&lt;Entity&gt;&gt;&lt;br&gt;&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;- id: UUID&lt;br&gt;- email: String&lt;br&gt;- firstName: String&lt;br&gt;- lastName: String&lt;br&gt;- gender: String&lt;br&gt;- createdAt: DateTime&lt;hr&gt;+ getFullName(): String&lt;br&gt;+ getPurchases(): Sale[]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="240" height="200" as="geometry" />
        </mxCell>

        <mxCell id="routine" value="&lt;&lt;Entity&gt;&gt;&lt;br&gt;&lt;b&gt;Routine&lt;/b&gt;&lt;hr&gt;- id: UUID&lt;br&gt;- name: String&lt;br&gt;- description: Text&lt;br&gt;- gender: String&lt;br&gt;- objective: String&lt;br&gt;- frequency: Integer&lt;br&gt;- durationWeeks: Integer&lt;br&gt;- price: Decimal&lt;br&gt;- weeks: JSONB&lt;hr&gt;+ getWeeks(): Week[]&lt;br&gt;+ exportToPDF(): Buffer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="240" height="260" as="geometry" />
        </mxCell>

        <mxCell id="sale" value="&lt;&lt;Entity&gt;&gt;&lt;br&gt;&lt;b&gt;Sale&lt;/b&gt;&lt;hr&gt;- id: UUID&lt;br&gt;- userEmail: String&lt;br&gt;- routineId: UUID&lt;br&gt;- amount: Decimal&lt;br&gt;- status: String&lt;br&gt;- mpPaymentId: String&lt;br&gt;- pdfUrl: String&lt;br&gt;- downloadCount: Integer&lt;hr&gt;+ isPaid(): Boolean&lt;br&gt;+ canDownload(): Boolean" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="240" height="240" as="geometry" />

<mxfile host="app.diagrams.net">
  <diagram id="diagrama-clases" name="Diagrama de Clases">
    <mxGraphModel dx="1500" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200">
      <root>
        <mxCell id="0" />

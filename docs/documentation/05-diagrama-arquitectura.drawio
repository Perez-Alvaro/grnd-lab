        <!-- Notas -->
        <mxCell id="note-stack" value="&lt;b&gt;Stack Tecnológico 100% Gratuito:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Frontend: React 18 + Vite + Tailwind&lt;br&gt;• Backend: Vercel Serverless Functions&lt;br&gt;• Database: Supabase (PostgreSQL)&lt;br&gt;• Storage: Supabase Storage&lt;br&gt;• Pagos: Mercado Pago&lt;br&gt;• Emails: Resend (3K/mes)&lt;br&gt;• Hosting: Vercel (CDN global)&lt;br&gt;&lt;br&gt;&lt;b&gt;Escalabilidad:&lt;/b&gt; Arquitectura serverless auto-escalable" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;size=20;" vertex="1" parent="1">

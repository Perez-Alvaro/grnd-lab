        <mxCell id="legend-content" value="🔑 = Clave Primaria (Primary Key)&lt;br&gt;🔗 = Clave Foránea (Foreign Key)&lt;br&gt;&lt;br&gt;Colores:&lt;br&gt;• Azul = Usuarios&lt;br&gt;• Verde = Rutinas/Plantillas&lt;br&gt;• Amarillo = Ventas/Transacciones&lt;br&gt;• Morado (línea punteada) = Fase 2&lt;br&gt;&lt;br&gt;JSONB weeks: Estructura completa de semanas,&lt;br&gt;días y ejercicios en formato JSON optimizado" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;overflow=hidden;rounded=1;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="920" y="640" width="280" height="200" as="geometry" />
        </mxCell>

        <!-- Nota SQL -->
        <mxCell id="sql-note" value="&lt;b&gt;Ejemplo SQL de creación:&lt;/b&gt;&lt;br&gt;&lt;br&gt;CREATE TABLE sales (&lt;br&gt;  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),&lt;br&gt;  user_email VARCHAR REFERENCES users(email),&lt;br&gt;  routine_id UUID REFERENCES routines(id),&lt;br&gt;  amount DECIMAL(10,2) NOT NULL,&lt;br&gt;  status VARCHAR DEFAULT 'pending',&lt;br&gt;  ...&lt;br&gt;);" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;size=20;" vertex="1" parent="1">

        <mxCell id="indices-content" value="✓ idx_users_email ON users(email)&lt;br&gt;✓ idx_sales_user_email ON sales(user_email)&lt;br&gt;✓ idx_sales_routine ON sales(routine_id)&lt;br&gt;✓ idx_sales_date ON sales(created_at)&lt;br&gt;✓ idx_routines_gender ON routines(gender)&lt;br&gt;✓ idx_routines_objective ON routines(objective)&lt;br&gt;✓ idx_routines_price ON routines(price)&lt;br&gt;✓ idx_downloads_sale ON downloads(sale_id)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;overflow=hidden;rounded=1;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
